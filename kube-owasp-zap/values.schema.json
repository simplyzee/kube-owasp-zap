{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": ["string", "number"] },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "scan": {
      "type": "object",
      "properties": {
        "target": { "type": "string" },
        "type": { "type": "string", "enum": ["baseline", "full", "api"] },
        "apiFormat": { "type": "string", "enum": ["openapi", "soap", "graphql"] },
        "spiderMinutes": { "type": "integer", "minimum": 0 },
        "ajaxSpider": { "type": "boolean" },
        "includeAlpha": { "type": "boolean" },
        "failOnWarnings": { "type": "boolean" },
        "maxMinutes": { "type": "integer", "minimum": 0 },
        "debug": { "type": "boolean" },
        "rulesConfig": { "type": "string" },
        "zapOptions": { "type": "string" },
        "extraArgs": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "formats": {
          "type": "array",
          "items": { "type": "string", "enum": ["html", "json", "md", "xml"] },
          "uniqueItems": true
        },
        "printToLog": { "type": "boolean" },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "existingClaim": { "type": "string" },
            "size": { "type": "string" },
            "storageClass": { "type": "string" },
            "accessModes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "schedule": { "type": "string" },
    "cronJob": {
      "type": "object",
      "properties": {
        "timeZone": { "type": "string" },
        "concurrencyPolicy": { "type": "string", "enum": ["Allow", "Forbid", "Replace"] },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "suspend": { "type": "boolean" }
      }
    },
    "job": {
      "type": "object",
      "properties": {
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": ["integer", "null"], "minimum": 1 },
        "ttlSecondsAfterFinished": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "automountServiceAccountToken": { "type": "boolean" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": ["object", "null"] },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
